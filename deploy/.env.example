API_KEY_FILE=/absolute/path/outside/repository/random-api-key
PUBLIC_API_URL=http://localhost:8080/api/
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Match the owner of the secret files; use an unprivileged UID/GID.
RUNTIME_UID=1000
RUNTIME_GID=1000
# Required only for the HTTPS override.
# PUBLIC_API_URL=https://your-domain.example/api/
# TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# TLS_KEY_FILE=/absolute/path/to/privkey.pem
# HTTPS_BIND=0.0.0.0
# HTTPS_PORT=443
